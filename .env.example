# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=dppuser
DB_PASSWORD=change_me_strong_password
DB_NAME=dppdb

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_random_256bit_secret
JWT_EXPIRY_HOURS=24

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
GRAFANA_PORT=3000

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PORT=9090

# ── Healthcheck tuning (optional — defaults shown) ────────────────────────────
HC_INTERVAL=15s
HC_TIMEOUT=5s
HC_RETRIES=3

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_CONTAINER=dpp-postgres

# ── Backup Configuration ──────────────────────────────────────────────────────
# Set to an rclone remote name to enable off-site cloud sync (e.g. myremote)
RCLONE_REMOTE_NAME=
