# Server
PORT=8080

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=dppuser
DB_PASSWORD=your_strong_password_here
DB_NAME=dppdb

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY_HOURS=24

# Admin (ilk çalıştırmada otomatik oluşturulur, şifre log'a yazılır)
ADMIN_USERNAME=admin

# Prometheus
PROMETHEUS_URL=http://prometheus:9090
